{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "server",
      "port": 5000
    },
    {
      "name": "server-local-db",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "MONGODB_URI=mongodb://127.0.0.1:27099/",
        "CENTRAL_DB_NAME=rbac_local_central",
        "TENANT_DB_PREFIX=rbac_local_tenant_",
        "REDIS_URL=",
        "EMAIL_HOST=127.0.0.1",
        "EMAIL_PORT=1",
        "npm",
        "run",
        "dev"
      ],
      "cwd": "server",
      "port": 5000
    },
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "client",
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "admin",
      "port": 5174
    },
    {
      "name": "schol",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "schol",
      "port": 5175
    },
    {
      "name": "school-intel-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "school-intel:api"
      ],
      "cwd": ".",
      "port": 8001
    },
    {
      "name": "landing",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--webpack",
        "-p",
        "3100"
      ],
      "cwd": "capabble-landing",
      "port": 3100
    }
  ]
}