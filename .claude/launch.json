{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "server",
      "port": 5001
    },
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "cwd": "client",
      "port": 5173
    },
    {
      "name": "admin",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5176",
        "--strictPort"
      ],
      "cwd": "admin",
      "port": 5176
    },
    {
      "name": "schol",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "schol",
      "port": 5175
    },
    {
      "name": "school-intel-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "school-intel:api"
      ],
      "cwd": ".",
      "port": 8001
    },
    {
      "name": "landing",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--webpack",
        "-p",
        "3100"
      ],
      "cwd": "capabble-landing",
      "port": 3100
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "cwd": "mobile",
      "port": 8081
    },
    {
      "name": "server-dev",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NODE_ENV=development",
        "npm",
        "run",
        "dev"
      ],
      "cwd": "server",
      "port": 5001
    },
    {
      "name": "mobile-ios",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--ios",
        "--port",
        "8082"
      ],
      "cwd": "mobile",
      "port": 8082
    },
    {
      "name": "client-pwa",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "cwd": "client",
      "port": 4173
    },
    {
      "name": "admin-pwa",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4174",
        "--strictPort"
      ],
      "cwd": "admin",
      "port": 4174
    }
  ]
}
