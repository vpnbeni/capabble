    { "prefix": "/libry", "path": "^/fines", "resource": "libry.fines" },
    { "prefix": "/libry", "path": "^/acquisitions", "resource": "libry.acquisitions" },
    { "prefix": "/libry", "path": "^/(suppliers|purchase-orders)", "resource": "libry.acquisitions" },
    { "prefix": "/libry", "path": "^/reports", "resource": "libry.reports" },
    { "prefix": "/libry", "path": "^/stocktakes", "resource": "libry.stocktake" },
    { "prefix": "/libry", "path": "^/audit", "resource": "libry.audit" },
    { "prefix": "/libry", "path": "^/digital-resources", "resource": "libry.digital" },
    { "prefix": "/libry", "path": "^/(reading-lists|reading-logs|reviews|challenges)", "resource": "libry.reading" },
    { "prefix": "/libry", "methods": ["POST"], "permission": "libry.catalogue.create" },
    { "prefix": "/libry", "resource": "libry.catalogue", "readAction": "view", "writeAction": "edit" },
    { "prefix": "/appnt", "resource": "appnt.appointments" }
