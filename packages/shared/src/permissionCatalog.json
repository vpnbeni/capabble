    { "prefix": "/answersheets", "resource": "exam.conduct" },
    { "prefix": "/dispatch", "resource": "exam.conduct" },
    { "prefix": "/form66", "resource": "exam.conduct" },
    { "prefix": "/duties", "resource": "exam.duties" },
    { "prefix": "/remuneration", "resource": "exam.duties" },
