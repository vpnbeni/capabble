# Database Configuration (single cluster URI, central + tenant DBs)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
CENTRAL_DB_NAME=becms_central
TENANT_DB_PREFIX=becms_tenant_
# Optional fallback for legacy scripts using default mongoose connection
DB_NAME=becms_tenant_local

# Server Configuration
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000/api
ROOT_APP_DOMAIN=becms.vpnbeni.com
ROOT_API_DOMAIN=api.vpnbeni.com

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here
JWT_REFRESH_EXPIRE=30d
PLATFORM_JWT_SECRET=your_super_secret_platform_jwt_key_here
PLATFORM_JWT_EXPIRE=1d
PLATFORM_ADMIN_EMAIL=admin.capabble
PLATFORM_ADMIN_PASSWORD=admin.capabble
PUBLIC_SIGNUP_TICKET_TTL_MINUTES=10
PUBLIC_SIGNUP_EMAIL_OTP_TTL_MINUTES=10
PUBLIC_SIGNUP_EMAIL_OTP_MAX_ATTEMPTS=5
PUBLIC_SIGNUP_START_RATE_LIMIT_MAX=5
PUBLIC_SIGNUP_START_RATE_LIMIT_WINDOW_MS=3600000
PUBLIC_SIGNUP_EXCHANGE_RATE_LIMIT_MAX=30
PUBLIC_SIGNUP_EXCHANGE_RATE_LIMIT_WINDOW_MS=900000
PUBLIC_SIGNUP_OTP_RESEND_RATE_LIMIT_MAX=10
PUBLIC_SIGNUP_OTP_RESEND_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_FORGOT_RATE_LIMIT_MAX=8
PASSWORD_RESET_FORGOT_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_RESET_RESEND_RATE_LIMIT_MAX=10
PASSWORD_RESET_RESEND_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_RESET_SUBMIT_RATE_LIMIT_MAX=20
PASSWORD_RESET_SUBMIT_RATE_LIMIT_WINDOW_MS=900000

# File Upload Configuration
MAX_FILE_SIZE=10485760
FILE_UPLOAD_PATH=./uploads

# Email Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com

# SMTP aliases (preferred)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com

# Frontend URL
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# Security
BCRYPT_ROUNDS=12

# Billing Service Integration
BILLING_SERVICE_URL=http://localhost:5100
BILLING_SERVICE_TOKEN=change_me
BILLING_ENFORCEMENT_ENABLED=true
BILLING_TRIAL_CORE_ONLY_ENABLED=true
BILLING_READ_ONLY_MODE_ENABLED=true
BILLING_GRACE_DAYS=7
BILLING_TRIAL_DAYS=14
BILLING_GRANDFATHER_DAYS=60
BILLING_DEFAULT_CURRENCY=INR
BILLING_TIMEZONE=Asia/Kolkata
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
