# Single-URL model: all tenants log in at school.capabble.cloud.
# Tenant identity is resolved from localStorage / JWT / ?tenant= query param — NOT from subdomain.
VITE_ROOT_APP_DOMAIN=capabble.cloud
VITE_ROOT_API_DOMAIN=api.capabble.cloud
VITE_LOCAL_API_URL=http://localhost:5000/api
VITE_API_URL=https://api.capabble.cloud/api

# Map tiles for bus tracking (Leaflet). Defaults to public OpenStreetMap tiles; use a paid/self-hosted tile server at scale.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
# Self-hosted map areas (.pmtiles) listed in regions.json; maps outside them use the tiles above. Set to off to disable.
# VITE_MAP_REGIONS_URL=https://tiles.capabble.tech/regions.json
