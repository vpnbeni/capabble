# Database Configuration (single cluster URI, central + tenant DBs)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
CENTRAL_DB_NAME=capabble_central
TENANT_DB_PREFIX=capabble_tenant_
# Optional fallback for legacy scripts using default mongoose connection
DB_NAME=capabble_tenant_local

# Server Configuration
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000/api
# ROOT_APP_DOMAIN: base domain for CORS wildcard allowance (subdomains allowed).
# With the single-URL model (school.capabble.cloud), this is no longer used for tenant routing
# but is kept for backward-compatibility CORS during any transition period.
ROOT_APP_DOMAIN=capabble.cloud
ROOT_API_DOMAIN=api.capabble.cloud

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here
JWT_REFRESH_EXPIRE=30d
PLATFORM_JWT_SECRET=your_super_secret_platform_jwt_key_here
PLATFORM_JWT_EXPIRE=1d
PLATFORM_ADMIN_EMAIL=admin.capabble
PLATFORM_ADMIN_PASSWORD=admin.capabble
PUBLIC_SIGNUP_TICKET_TTL_MINUTES=10
PUBLIC_SIGNUP_EMAIL_OTP_TTL_MINUTES=10
PUBLIC_SIGNUP_EMAIL_OTP_MAX_ATTEMPTS=5
PUBLIC_SIGNUP_START_RATE_LIMIT_MAX=5
PUBLIC_SIGNUP_START_RATE_LIMIT_WINDOW_MS=3600000
PUBLIC_SIGNUP_EXCHANGE_RATE_LIMIT_MAX=30
PUBLIC_SIGNUP_EXCHANGE_RATE_LIMIT_WINDOW_MS=900000
PUBLIC_SIGNUP_OTP_RESEND_RATE_LIMIT_MAX=10
PUBLIC_SIGNUP_OTP_RESEND_RATE_LIMIT_WINDOW_MS=900000

# File Upload Configuration
MAX_FILE_SIZE=10485760
FILE_UPLOAD_PATH=./uploads

# Email: every platform email is sent from the no-reply@capabble.cloud mailbox on Hostinger.
# Templates: src/mail. Check the login with `npm run mail:test -- --verify`,
# send samples with `npm run mail:test -- --to you@example.com`, preview with `npm run mail:preview`.
# Leave SMTP_* unset to run without email (codes are then not delivered).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@capabble.cloud
SMTP_PASS=the_mailbox_password
SMTP_FROM=Capabble <no-reply@capabble.cloud>
# Optional: where replies go (a monitored inbox). Unset = emails say the mailbox isn't monitored.
# MAIL_REPLY_TO=support@capabble.cloud
# Optional: the site linked in every email footer (default https://capabble.cloud)
# MAIL_SITE_URL=https://capabble.cloud

# School emails (calendar events): sent from a separate mailbox so a big school event never
# uses up no-reply@'s daily limit. A school can also connect its own account in
# Settings → School email; then its mail goes from there instead.
# MAIL_EVENTS_HOST=smtp.hostinger.com            # defaults to SMTP_HOST
# MAIL_EVENTS_PORT=465
# MAIL_EVENTS_SECURE=true
# MAIL_EVENTS_USER=events@capabble.cloud
# MAIL_EVENTS_PASS=the_mailbox_password
# MAIL_EVENTS_FROM=events@capabble.cloud
# Each school's fair share of the events mailbox per day; the rest waits until the next day.
# MAIL_EVENTS_DAILY_CAP_PER_TENANT=300
# Encrypts schools' own SMTP passwords: 32 random bytes, base64 (openssl rand -base64 32).
# Keep a copy in the password manager; falls back to a key derived from JWT_SECRET.
# MAIL_CREDENTIALS_KEY=
# Signs unsubscribe links (falls back to JWT_SECRET).
# MAIL_LINK_SECRET=
# Online fee payments (each school's own Razorpay keys, encrypted with MAIL_CREDENTIALS_KEY):
# signs the app's checkout links. Falls back to JWT_SECRET.
# PAYMENT_LINK_SECRET=
# Background sender for school emails (every minute). Set false to hold all school emails.
MAIL_OUTBOX_ENABLED=true
# Push notifications to the Capabble app through Expo (every 30 s). Set false to hold all pushes.
PUSH_OUTBOX_ENABLED=true
# Only once "enhanced push security" is on for the Expo project (expo.dev → project → Credentials).
# EXPO_ACCESS_TOKEN=
# Comma-separated list of admin emails to notify on new tenant registration
ADMIN_EMAILS=admin1@example.com,admin2@example.com
# Who gets an email for each "Request a demo" lead from capabble.cloud (comma-separated)
DEMO_LEAD_NOTIFY_EMAIL=capabbles@gmail.com
# Admin portal origin, used for the "Open demo requests" link in that email (optional)
# ADMIN_PORTAL_URL=https://admin.capabble.cloud
# PUBLIC_DEMO_REQUEST_RATE_LIMIT_WINDOW_MS=3600000
# PUBLIC_DEMO_REQUEST_RATE_LIMIT_MAX=5

# Frontend URL — single client URL (production: https://school.capabble.cloud)
CLIENT_URL=http://localhost:5173
# CLIENT_URLS: comma-separated list of additional allowed origins (e.g. staging URLs)
# CLIENT_URLS=https://school.capabble.cloud

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# Security
BCRYPT_ROUNDS=12

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Backups, workspace archives and purges (server/docs/backups.md). Off unless enabled.
BACKUP_ENABLED=false
WORKSPACE_LIFECYCLE_ENABLED=false
BACKUP_STORAGE=s3
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=ap-south-1
# BACKUP_LOCAL_DIR=/path/to/folder   # with BACKUP_STORAGE=local (dev only)
# openssl rand -base64 32 — keep a copy in the password manager, never next to the backups
BACKUP_ENCRYPTION_KEY=
BACKUP_HOUR_IST=2
ARCHIVE_LINK_SECRET=
ADMIN_URL=https://admin.capabble.cloud
SUPPORT_EMAIL=support@capabble.cloud
# Testing only: lets `npm run workspace:lifecycle -- --now=<date>` pretend a later date. Never in production.
WORKSPACE_CLOCK_OVERRIDE_ALLOWED=false

# Billing (src/modules/billing). Its own Postgres database; leave empty to run without billing.
# Neon: the pooled URL (host contains -pooler) and the direct URL for migrations.
# Use a development branch outside production.
BILLING_DATABASE_URL=
BILLING_DATABASE_URL_UNPOOLED=
# Providers with their own CA (e.g. Aiven): path to the CA file, or the PEM itself.
BILLING_DATABASE_CA_CERT=
# Run `npm run billing:grandfather -- --apply` before enabling this in an environment.
BILLING_ENFORCEMENT_ENABLED=true
BILLING_TRIAL_CORE_ONLY_ENABLED=true
BILLING_READ_ONLY_MODE_ENABLED=true
BILLING_TRIAL_DAYS=14
BILLING_GRACE_DAYS=7
BILLING_GRANDFATHER_DAYS=60
BILLING_INVOICE_DUE_DAYS=7
BILLING_RENEWAL_LEAD_DAYS=7
BILLING_TIMEZONE=Asia/Kolkata
BILLING_SCHEDULER_ENABLED=true

# In-app notification reminders (fees due, meetings tomorrow, maintenance due), hourly
NOTIFICATION_SCHEDULER_ENABLED=true
# Calendar: scheduled publishing (every minute) and event reminders (6 pm the day before, 7 am on the day; every 15 min)
CALENDAR_JOBS_ENABLED=true
BILLING_AUTODEBIT_ENABLED=false
# Link in reminder emails (sent with the SMTP/EMAIL settings above).
BILLING_APP_URL=https://school.capabble.cloud/#/billing
# Printed on every invoice. The state code decides CGST+SGST (same state) or IGST.
BILLING_SUPPLIER_LEGAL_NAME=
BILLING_SUPPLIER_GSTIN=
BILLING_SUPPLIER_STATE_CODE=
BILLING_SUPPLIER_ADDRESS=
BILLING_SUPPLIER_EMAIL=
BILLING_SAC_CODE=998314
# Razorpay (rzp_test_ keys outside production). Webhook: <api host>/api/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# The app's link scheme for "Back to the app" after paying online: capabble (live app, default)
# or capabble-stage on the stage server (the "(S) Capabble" app).
# APP_SCHEME=capabble

# School transport maps: the OSRM server that works out the road between a route's stops,
# so maps follow the roads. Asked once per set of stop positions (kept on the route).
# Default is the public OSRM server (light use only); set your own for heavy use, or `off`
# to draw straight lines between stops.
# ROUTING_URL=https://router.project-osrm.org
