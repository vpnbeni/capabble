{
  "name": "capabble-server",
  "version": "1.0.0",
  "description": "Backend API for Examination Management System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "build": "echo 'No build step for server'",
    "dev": "nodemon src/server.js",
    "seed": "node src/seeders/index.js",
    "seed:subjects": "node scripts/seeds/seed-subjects.js",
    "seed:asets": "node scripts/seeds/seed-asets.js",
    "bootstrap:platform": "node scripts/tenants/bootstrap-platform.js",
    "platform:admin": "node scripts/tenants/set-platform-admin.js",
    "db:collections": "node scripts/checks/list-empty-collections.js",
    "db:drop-empty": "node scripts/tenants/drop-empty-collections.js",
    "db:drop-databases": "node scripts/tenants/drop-databases.js",
    "backfill:tenant-user-directory": "node scripts/tenants/backfill-tenant-user-directory.js",
    "backfill:academic-session": "node scripts/migrations/backfill-academic-session.js",
    "migrate:rbac": "node scripts/migrations/migrate-rbac.js",
    "migrate:placeholder-emails": "node scripts/migrations/migrate-placeholder-emails.js",
    "migrate:oasis-id": "node scripts/migrations/migrate-teacher-oasis-id.js",
    "billing:grandfather": "node scripts/tenants/grandfather-billing.js",
    "billing:invite-legacy-trials": "node scripts/billing/invite-legacy-trials.js",
    "billing:launch-pricing": "node scripts/billing/set-launch-pricing.js",
    "mail:preview": "node scripts/mail/preview.js",
    "mail:test": "node scripts/mail/test-send.js",
    "test": "jest --watchAll --verbose",
    "test:cloudinary": "node scripts/tests/test-cloudinary.js",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "postinstall": "npx puppeteer browsers install chrome || echo \"[postinstall] puppeteer chrome install skipped\"",
    "billing:db:generate": "drizzle-kit generate --config drizzle.billing.config.js",
    "billing:db:migrate": "node src/modules/billing/db/migrate.js",
    "billing:db:seed": "node scripts/billing/seed-catalog.js",
    "billing:db:studio": "drizzle-kit studio --config drizzle.billing.config.js",
    "test:billing": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "tenant:purge": "node scripts/tenants/purge-tenant.js",
    "backup:setup": "node scripts/backups/backup.js setup",
    "backup:run": "node scripts/backups/backup.js run",
    "backup:list": "node scripts/backups/backup.js list",
    "backup:restore": "node scripts/backups/restore.js",
    "workspace:archive": "node scripts/backups/workspace.js archive",
    "workspace:lifecycle": "node scripts/backups/workspace.js lifecycle"
  },
  "keywords": [
    "express",
    "mongodb",
    "jwt",
    "api",
    "examination"
  ],
  "author": "Capabble Development Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/lib-storage": "^3.1154.0",
    "@aws-sdk/s3-request-presigner": "^3.1154.0",
    "archiver": "^5.3.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.81.3",
    "cloudinary": "^2.8.0",
    "colors": "1.4.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-fileupload": "^1.4.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "handlebars": "^4.7.10",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.10.1",
    "joi": "^17.13.8",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.3",
    "morgan": "^1.12.1",
    "node-geocoder": "^4.2.0",
    "nodemailer": "^10.2.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.4",
    "pdf2pic": "^3.2.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "puppeteer": "^25.8.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "slugify": "^1.6.6",
    "tesseract.js": "^6.0.1",
    "unzipper": "^0.10.14",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^8.55.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "ajv@6": "6.15.0",
    "basic-ftp": "5.3.1",
    "body-parser": "1.20.6",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "flatted": "3.4.4",
    "form-data": "4.0.6",
    "ip-address": "10.5.0",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "lodash": "4.18.1",
    "minimatch@3": "3.1.5",
    "minimatch@5": "5.1.9",
    "minimatch@9": "9.0.9",
    "express": {
      "path-to-regexp": "0.1.13"
    },
    "picomatch": "2.3.2",
    "qs": "6.16.1",
    "tmp": "0.2.7",
    "exceljs": {
      "uuid": "11.1.1"
    },
    "ws": "8.21.3",
    "proxy-addr": "2.0.8"
  }
}
