{
  "name": "capabble-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:stage": "EXPO_PUBLIC_API_URL=https://stageapi.capabble.cloud/api expo start --go",
    "start:live": "APP_VARIANT=production EXPO_PUBLIC_API_URL=https://api.capabble.cloud/api expo start --go",
    "ios": "expo start --go --ios",
    "ios:stage": "EXPO_PUBLIC_API_URL=https://stageapi.capabble.cloud/api expo start --go --ios",
    "ios:live": "APP_VARIANT=production EXPO_PUBLIC_API_URL=https://api.capabble.cloud/api expo start --go --ios",
    "android": "expo start --go --android",
    "android:stage": "EXPO_PUBLIC_API_URL=https://stageapi.capabble.cloud/api expo start --go --android",
    "android:live": "APP_VARIANT=production EXPO_PUBLIC_API_URL=https://api.capabble.cloud/api expo start --go --android",
    "web": "expo start --web",
    "lint": "expo lint",
    "type-check": "tsc --noEmit",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~58.0.21",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.17",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.12",
    "expo-updates": "~58.0.19",
    "lucide-react-native": "^1.61.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "^22.13.0 || >=24.3.0"
  },
  "allowScripts": {
    "unrs-resolver": true
  }
}
