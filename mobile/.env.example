# Copy to .env.local (git-ignored). Expo inlines EXPO_PUBLIC_* values into the app bundle:
# never put a secret here.

# API base URL, ending in /api. Leave unset in development to use port 5000 on the machine
# running Metro (works from a phone on the same Wi-Fi). EAS build profiles will set it for
# stage and production (https://api.capabble.cloud/api, also the fallback when unset).
# EXPO_PUBLIC_API_URL=http://localhost:5001/api
