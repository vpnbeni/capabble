{
  "name": "examination-management-system",
  "version": "1.0.0",
  "description": "Full-Stack MERN Examination Management System",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "dev:all": "concurrently \"npm run server\" \"npm run client\" \"npm run admin\"",
    "dev:all:billing": "concurrently \"npm run server\" \"npm run client\" \"npm run admin\" \"npm run billing\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "admin": "cd admin && npm run dev",
    "billing": "cd billing-service && npm run dev",
    "install-server": "cd server && npm install",
    "install-client": "cd client && npm install",
    "install-admin": "cd admin && npm install",
    "install-billing": "cd billing-service && npm install",
    "install-all": "npm install && npm run install-server && npm run install-client && npm run install-admin && npm run install-billing",
    "seed": "cd server && npm run seed",
    "build": "cd client && npm run build",
    "build:admin": "cd admin && npm run build",
    "start": "cd server && npm start",
    "test": "concurrently \"cd server && npm test\" \"cd client && npm test\"",
    "lint": "concurrently \"cd server && npm run lint\" \"cd client && npm run lint\"",
    "clean": "rimraf node_modules client/node_modules server/node_modules admin/node_modules client/dist server/dist admin/dist",
    "school-intel:migrate": "cd school-intelligence && school-intel migrate",
    "school-intel:test": "cd school-intelligence && python -m pytest -q",
    "school-intel:test:live": "cd school-intelligence && python -m pytest -m live -q",
    "school-intel:saras:test": "cd school-intelligence && python -m pytest tests/test_saras_parser.py -q",
    "school-intel:api": "cd school-intelligence && uvicorn school_intel.api.app:app --reload --port 8001",
    "schol": "cd schol && npm run dev",
    "schol:install": "cd schol && npm install",
    "dev:schol": "concurrently \"npm run school-intel:api\" \"npm run schol\""
  },
  "keywords": [
    "examination",
    "management",
    "system",
    "mern",
    "react",
    "nodejs",
    "mongodb",
    "express"
  ],
  "author": "BECMS Development Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.2.4",
    "rimraf": "^6.1.3"
  },
  "overrides": {
    "brace-expansion@2": "2.1.4",
    "glob@10": "10.5.0",
    "lodash": "4.18.1",
    "minimatch@9": "9.0.9",
    "shell-quote": "1.10.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/examination-management-system.git"
  }
}
