NODE_ENV=development
PORT=5100

# Billing database (Postgres). Only this service reads or writes it.
# Neon: DATABASE_URL is the pooled URL (host contains -pooler); DATABASE_URL_UNPOOLED is the
# direct URL, used by `npm run db:migrate`. Use a Neon development branch, never production.
DATABASE_URL=postgres://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/billing?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@ep-example.ap-southeast-1.aws.neon.tech/billing?sslmode=require
# Providers with their own CA (e.g. Aiven): path to the CA file, or the PEM itself.
DATABASE_CA_CERT=
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000

# Shared with the main server (server/.env BILLING_SERVICE_TOKEN). Required in production.
BILLING_SERVICE_TOKEN=change_me
# Main server, for the live student count when Students is on.
ERP_INTERNAL_URL=http://localhost:5000
# Link in reminder emails.
BILLING_APP_URL=https://school.capabble.cloud/#/billing

BILLING_TRIAL_DAYS=14
BILLING_GRACE_DAYS=7
BILLING_GRANDFATHER_DAYS=60
BILLING_INVOICE_DUE_DAYS=7
BILLING_RENEWAL_LEAD_DAYS=7
BILLING_ENTITLEMENT_TTL_SECONDS=60
BILLING_DEFAULT_CURRENCY=INR
BILLING_TIMEZONE=Asia/Kolkata
BILLING_SCHEDULER_ENABLED=true
BILLING_AUTODEBIT_ENABLED=false

# Printed on every invoice. The state code decides CGST+SGST (same state) or IGST.
BILLING_SUPPLIER_LEGAL_NAME=
BILLING_SUPPLIER_GSTIN=
BILLING_SUPPLIER_STATE_CODE=
BILLING_SUPPLIER_ADDRESS=
BILLING_SUPPLIER_EMAIL=
BILLING_SAC_CODE=998314

# Razorpay (use rzp_test_ keys outside production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Reminder emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
BILLING_MAIL_FROM=
