{
  "name": "capabble-ledger-service",
  "version": "1.0.0",
  "description": "Capabble billing service (Neon Postgres)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node scripts/seed-catalog.js",
    "db:studio": "drizzle-kit studio",
    "lint": "node --check src/server.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.4",
    "express": "^4.18.2",
    "joi": "^17.13.8",
    "morgan": "^1.10.0",
    "nodemailer": "^9.1.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "razorpay": "^2.9.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "drizzle-kit": "^0.31.11",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "testTimeout": 30000
  }
}
