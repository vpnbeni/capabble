# PostgreSQL connection for School Intelligence (separate from Capabble MongoDB)
SCHOOL_INTEL_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/capabble_school_intel

# Isolated PostgreSQL database for pytest ONLY — must NOT be capabble_school_intel
# SCHOOL_INTEL_TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/capabble_school_intel_test

# Cloud Postgres (Neon etc.) for dump/restore sync between machines — never commit real credentials
# Prefer Neon direct (non-pooler) host for pg_dump / pg_restore if pooler fails
# SCHOOL_INTEL_CLOUD_DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Optional: link to Capabble central Mongo for tenant conversion (future)
# CAPABBLE_MONGODB_URI=mongodb://127.0.0.1:27017
# CAPABBLE_CENTRAL_DB_NAME=sems_central

# Capabble-team shared login for SCHOL UI/API (when password is set, Bearer auth is required)
SCHOL_DEV_USERNAME=capabble
SCHOL_DEV_PASSWORD=
# Optional; defaults to a password-derived secret when empty
# SCHOL_DEV_TOKEN_SECRET=
# SCHOL_DEV_TOKEN_TTL_SECONDS=604800

# Collector defaults
SCHOOL_INTEL_HTTP_TIMEOUT_SECONDS=30
SCHOOL_INTEL_HTTP_MAX_RETRIES=3
KYS_REQUEST_DELAY_SECONDS=1.0
KYS_MAX_RETRIES=3
KYS_TIMEOUT_SECONDS=30

# KYS / UDISE endpoints (override when source URLs change)
KYS_BASE_URL=https://kys.udiseplus.gov.in
SARAS_BASE_URL=https://saras.cbse.gov.in

# SCHOL local UI (Vite, repo /schol): http://schol.capabble.localhost:5175
# Start: npm run dev:schol  (from capabble repo root)
